# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=osync
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=osync

# ── MinIO (S3-compatible storage) ────────────────────────────
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_8_CHARS
S3_BUCKET=osync-bucket
S3_REGION=us-east-1

# MinIO server-side encryption key
# Format: name:base64(32 random bytes)
# Generate: echo "osync-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=osync-key:CHANGE_ME_BASE64_32_BYTES

# ── Auth ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_HEX_64_CHARS
SYNC_TOKEN_SECRET=CHANGE_ME_DIFFERENT_HEX_64_CHARS

# ── App ───────────────────────────────────────────────────────
PORT=3000

# UI language: en (default) or ko
LANGUAGE=en

# Image tag. Leave as-is for normal CPUs. If your CPU lacks AVX2 (e.g. Intel
# Celeron/Pentium) and the api container crashes with "Illegal instruction
# (core dumped)", use the baseline build: IMAGE_TAG=latest-baseline
IMAGE_TAG=latest
PUBLIC_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# Public URL of MinIO, used for presigned blob uploads/downloads
# (e.g. https://osync-s3.your-domain.com). Both values must be identical.
# MINIO_PUBLIC_URL is passed to MinIO as MINIO_SERVER_URL.
# Leave both empty only when clients run on the same host as the server.
S3_PUBLIC_ENDPOINT=
MINIO_PUBLIC_URL=

SELF_HOSTED=true
SYNC_TOKEN_TTL_SECONDS=120
COORDINATOR_DATA_DIR=/data/coordinators

# ── Admin account (first run only) ───────────────────────────
# Set these to auto-create an admin account on first start.
# Remove or leave empty after the account is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
